# Neon PostgreSQL Connection String (for Vercel or cloud persistence)
# Example: postgresql://neondb_owner:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Server port (local dev defaults to 3000)
PORT=3000

# Local SQLite fallback path (when DATABASE_URL is not set)
DB_PATH=./data/verdict.sqlite
